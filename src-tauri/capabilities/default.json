{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与悬浮球的默认权限",
  "windows": ["main", "ball"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-theme"
  ]
}
